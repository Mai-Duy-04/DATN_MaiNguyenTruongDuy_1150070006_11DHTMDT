
@model List<TourWebApp.Data.Models.DonDatTour>
@using System
@using System.Collections.Generic
@using System.Linq

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Quản lý Check-in tour";

    var ngayChon = ViewBag.NgayChon is DateOnly ngay
        ? ngay
        : DateOnly.FromDateTime(DateTime.Today);

    var idsDaCheckIn =
        ViewBag.DanhSachDaCheckIn as HashSet<int>
        ?? new HashSet<int>();

    int tongDon = ViewBag.TongDon is int td ? td : Model.Count;

    int tongKhach = ViewBag.TongKhach is int tk
        ? tk
        : Model.Sum(x => x.NguoiLon + x.TreEm + x.TreNho);

    int soDonDaCheckIn = ViewBag.SoDonDaCheckIn is int dc
        ? dc
        : 0;

    int soKhachDaCheckIn = ViewBag.SoKhachDaCheckIn is int kc
        ? kc
        : 0;

    int soDonChuaCheckIn = Math.Max(0, tongDon - soDonDaCheckIn);

    string ngayHienThi = ngayChon.ToString("dd/MM/yyyy");
}

<div class="ht-checkin-page">

    <div class="ht-checkin-heading">
        <div>
            <div class="ht-checkin-breadcrumb">
                <i class="fa-solid fa-house"></i>
                <span>Quản lý vận hành</span>
                <i class="fa-solid fa-chevron-right"></i>
                <strong>Check-in tour</strong>
            </div>

            <h1>Quản lý Check-in tour</h1>

            <p>
                Kiểm tra vé điện tử và theo dõi khách tham gia
                theo lịch khởi hành.
            </p>
        </div>

        <div class="ht-heading-date">
            <i class="fa-regular fa-calendar"></i>
            @ngayHienThi
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="ht-checkin-alert success">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="ht-checkin-alert error">
            <i class="fa-solid fa-circle-exclamation"></i>
            @TempData["Error"]
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="ht-checkin-alert info">
            <i class="fa-solid fa-circle-info"></i>
            @TempData["Info"]
        </div>
    }

    <div class="ht-checkin-stats">

        <div class="ht-stat-card">
            <div class="ht-stat-icon green">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div>
                <span>Đơn đặt tour</span>
                <strong>@tongDon</strong>
                <small>Theo ngày khởi hành</small>
            </div>
        </div>

        <div class="ht-stat-card">
            <div class="ht-stat-icon blue">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <span>Tổng hành khách</span>
                <strong>@tongKhach</strong>
                <small>Trong các đơn hợp lệ</small>
            </div>
        </div>

        <div class="ht-stat-card">
            <div class="ht-stat-icon emerald">
                <i class="fa-solid fa-check-double"></i>
            </div>
            <div>
                <span>Đã check-in</span>
                <strong>@soKhachDaCheckIn</strong>
                <small>@soDonDaCheckIn đơn đã xác nhận</small>
            </div>
        </div>

        <div class="ht-stat-card">
            <div class="ht-stat-icon amber">
                <i class="fa-regular fa-clock"></i>
            </div>
            <div>
                <span>Chưa check-in</span>
                <strong>@soDonChuaCheckIn</strong>
                <small>Đơn đang chờ xác nhận</small>
            </div>
        </div>

    </div>

    <div class="ht-checkin-tools">

        <section class="ht-checkin-panel ht-scan-panel">

            <div class="ht-panel-heading">
                <span class="ht-panel-icon">
                    <i class="fa-solid fa-qrcode"></i>
                </span>

                <div>
                    <h2>Kiểm tra vé điện tử</h2>
                    <p>Nhập token hoặc dán liên kết từ mã QR của khách.</p>
                </div>
            </div>

            <form id="htScanForm"
                  method="get"
                  asp-controller="QuanLyDon"
                  asp-action="ScanCheckIn">

                <label for="htQrInput">
                    Mã QR / Đường dẫn xác nhận
                </label>

                <div class="ht-qr-input-wrap">
                    <i class="fa-solid fa-link"></i>

                    <input id="htQrInput"
                           name="token"
                           type="text"
                           autocomplete="off"
                           spellcheck="false"
                           required
                           placeholder="Dán mã QR hoặc đường dẫn vào đây..." />
                </div>

                <p id="htQrError"
                   class="ht-input-error"
                   role="alert"
                   hidden></p>

                <button type="submit" class="ht-scan-button">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Kiểm tra vé
                </button>
            </form>

            <div class="ht-scan-note">
                <i class="fa-solid fa-shield-halved"></i>
                Vé được xác minh bằng token bảo mật.
                Việc kiểm tra không tự động ghi nhận check-in.
            </div>

        </section>

        <section class="ht-checkin-panel ht-filter-panel">

            <div class="ht-panel-heading">
                <span class="ht-panel-icon light">
                    <i class="fa-regular fa-calendar-days"></i>
                </span>

                <div>
                    <h2>Lịch khởi hành</h2>
                    <p>Chọn ngày để theo dõi danh sách hành khách.</p>
                </div>
            </div>

            <form asp-controller="QuanLyDon"
                  asp-action="QuanLyCheckIn"
                  method="get">

                <label for="htNgayKhoiHanh">
                    Ngày khởi hành
                </label>

                <input id="htNgayKhoiHanh"
                       class="ht-date-input"
                       type="date"
                       name="ngay"
                       value="@ngayChon.ToString("yyyy-MM-dd")" />

                <button type="submit" class="ht-filter-button">
                    <i class="fa-solid fa-filter"></i>
                    Xem danh sách
                </button>

            </form>

            <div class="ht-filter-note">
                <i class="fa-solid fa-circle-info"></i>
                Chỉ hiển thị đơn đã thanh toán và chưa bị hủy.
            </div>

        </section>

    </div>

    <section class="ht-checkin-panel ht-list-panel">

        <div class="ht-list-heading">
            <div>
                <h2>Danh sách hành khách</h2>
                <p>
                    Các đơn đặt tour khởi hành ngày
                    <strong>@ngayHienThi</strong>
                </p>
            </div>

            <span class="ht-list-count">
                @tongDon đơn
            </span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="ht-checkin-empty">
                <div>
                    <i class="fa-regular fa-calendar-xmark"></i>
                </div>

                <h3>Chưa có đơn đặt tour phù hợp</h3>

                <p>
                    Không tìm thấy đơn đã thanh toán cho
                    ngày khởi hành đang chọn.
                </p>
            </div>
        }
        else
        {
            <div class="ht-table-scroll">
                <table class="ht-checkin-table">
                    <thead>
                        <tr>
                            <th>Mã đặt tour</th>
                            <th>Khách hàng</th>
                            <th>Tour du lịch</th>
                            <th>Hành khách</th>
                            <th>Check-in</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var don in Model)
                        {
                            bool daCheckIn =
                                idsDaCheckIn.Contains(don.IdDon);

                            int soKhach =
                                don.NguoiLon +
                                don.TreEm +
                                don.TreNho;

                            <tr>
                                <td>
                                    <strong class="ht-booking-code">
                                        @don.MaBooking
                                    </strong>
                                    <span class="ht-small-text">
                                        #@don.IdDon
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        @(don.IdTaiKhoanNavigation?.HoTen
                                          ?? "Chưa cập nhật")
                                    </strong>
                                </td>

                                <td class="ht-tour-cell">
                                    <strong>
                                        @(don.IdTourNavigation?.TenTour
                                          ?? "Chưa cập nhật")
                                    </strong>

                                    <span class="ht-small-text">
                                        Lịch #@don.IdLich
                                    </span>
                                </td>

                                <td>
                                    <span class="ht-guest-count">
                                        <i class="fa-solid fa-user-group"></i>
                                        @soKhach
                                    </span>
                                </td>

                                <td>
                                    @if (daCheckIn)
                                    {
                                        <span class="ht-status completed">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Đã check-in
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="ht-status pending">
                                            <i class="fa-regular fa-clock"></i>
                                            Chưa check-in
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-controller="QuanLyDon"
                                       asp-action="ChiTiet"
                                       asp-route-id="@don.IdDon"
                                       class="ht-detail-link">
                                        <i class="fa-regular fa-eye"></i>
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </section>

</div>

<style>
    .ht-checkin-page {
        font-family: "Be Vietnam Pro", Arial, sans-serif;
        color: #294537;
        padding: 4px 2px 30px;
        max-width: 1500px;
        margin: 0 auto;
    }

    .ht-checkin-page *,
    .ht-checkin-page *::before,
    .ht-checkin-page *::after {
        box-sizing: border-box;
    }

    .ht-checkin-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .ht-checkin-breadcrumb {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 11px;
        color: #8e9b90;
        margin-bottom: 12px;
    }

    .ht-checkin-breadcrumb strong {
        color: #368255;
        font-weight: 700;
    }

    .ht-checkin-heading h1 {
        margin: 0 0 8px;
        font-size: 25px;
        font-weight: 800;
        color: #254d36;
    }

    .ht-checkin-heading p {
        margin: 0;
        color: #89988b;
        font-size: 12px;
    }

    .ht-heading-date {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: #fff;
        border: 1px solid #e1e9df;
        padding: 11px 15px;
        border-radius: 11px;
        color: #397551;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .ht-checkin-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .ht-stat-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 19px;
        background: #fff;
        border: 1px solid #e7ece5;
        border-radius: 15px;
        min-width: 0;
    }

    .ht-stat-icon {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 13px;
        font-size: 19px;
    }

    .ht-stat-icon.green {
        background: #edf7eb;
        color: #438659;
    }

    .ht-stat-icon.blue {
        background: #edf3fc;
        color: #6385ba;
    }

    .ht-stat-icon.emerald {
        background: #e5f6ed;
        color: #258658;
    }

    .ht-stat-icon.amber {
        background: #fff5e3;
        color: #bb883a;
    }

    .ht-stat-card span,
    .ht-stat-card small {
        display: block;
        font-size: 11px;
        color: #91a094;
    }

    .ht-stat-card strong {
        display: block;
        margin: 5px 0;
        font-size: 27px;
        line-height: 1.15;
        color: #28563c;
        font-weight: 800;
    }

    .ht-checkin-tools {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .ht-checkin-panel {
        background: #fff;
        border: 1px solid #e6ece5;
        border-radius: 16px;
        padding: 22px;
        min-width: 0;
    }

    .ht-panel-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .ht-panel-icon {
        width: 43px;
        height: 43px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 12px;
        background: #e7f4e9;
        color: #307b4f;
        font-size: 18px;
    }

    .ht-panel-icon.light {
        background: #f0f4e9;
        color: #678854;
    }

    .ht-panel-heading h2,
    .ht-list-heading h2 {
        font-size: 15px;
        font-weight: 800;
        color: #2d553d;
        margin: 0 0 5px;
    }

    .ht-panel-heading p,
    .ht-list-heading p {
        margin: 0;
        font-size: 11px;
        color: #95a196;
        line-height: 1.6;
    }

    .ht-checkin-panel label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: #556c5a;
        margin-bottom: 10px;
    }

    .ht-qr-input-wrap {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 0 14px;
        height: 47px;
        border: 1px solid #dce7db;
        border-radius: 10px;
        background: #fcfdfa;
    }

    .ht-qr-input-wrap i {
        color: #83a18a;
    }

    .ht-qr-input-wrap input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        font-size: 12px;
        color: #314d3a;
    }

    .ht-date-input {
        width: 100%;
        height: 47px;
        padding: 0 13px;
        border: 1px solid #dce7db;
        border-radius: 10px;
        background: #fcfdfa;
        color: #35533e;
        font-size: 12px;
    }

    .ht-scan-button,
    .ht-filter-button {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        width: 100%;
        border: 0;
        border-radius: 10px;
        height: 43px;
        margin-top: 14px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

    .ht-scan-button {
        background: #277b4d;
        color: white;
    }

    .ht-scan-button:hover {
        background: #1e653e;
    }

    .ht-filter-button {
        background: #eef5eb;
        color: #33734b;
    }

    .ht-filter-button:hover {
        background: #e1efdf;
    }

    .ht-scan-note,
    .ht-filter-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 17px;
        font-size: 10px;
        line-height: 1.8;
        color: #95a397;
    }

    .ht-scan-note i,
    .ht-filter-note i {
        margin-top: 3px;
        color: #5d9a70;
    }

    .ht-input-error {
        color: #be5547;
        font-size: 11px;
        margin: 9px 0 0;
    }

    .ht-list-panel {
        padding: 0;
        overflow: hidden;
    }

    .ht-list-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 21px 23px;
        border-bottom: 1px solid #e9eee8;
    }

    .ht-list-count {
        padding: 7px 12px;
        border-radius: 9px;
        background: #eef6ed;
        color: #397b4d;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .ht-table-scroll {
        overflow-x: auto;
    }

    .ht-checkin-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .ht-checkin-table th {
        background: #fafcf9;
        padding: 15px 18px;
        font-size: 10px;
        color: #8e9d90;
        font-weight: 800;
        white-space: nowrap;
    }

    .ht-checkin-table td {
        padding: 16px 18px;
        border-top: 1px solid #eef1ed;
        font-size: 11px;
        color: #415947;
        vertical-align: middle;
    }

    .ht-checkin-table td strong {
        display: block;
        font-weight: 700;
    }

    .ht-booking-code {
        color: #2d8050;
        font-weight: 800;
    }

    .ht-small-text {
        display: block;
        color: #9ba79d;
        font-size: 10px;
        margin-top: 5px;
    }

    .ht-tour-cell {
        min-width: 190px;
        max-width: 310px;
        line-height: 1.6;
    }

    .ht-guest-count {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-weight: 800;
        color: #456b51;
    }

    .ht-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .ht-status.completed {
        background: #e8f5eb;
        color: #29814b;
    }

    .ht-status.pending {
        background: #fff5e7;
        color: #af813a;
    }

    .ht-detail-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 11px;
        background: #f1f7ef;
        color: #39794f;
        text-decoration: none;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .ht-detail-link:hover {
        background: #e4f1e2;
        color: #24613b;
    }

    .ht-checkin-empty {
        text-align: center;
        padding: 65px 20px;
    }

    .ht-checkin-empty > div {
        display: grid;
        place-items: center;
        margin: 0 auto 18px;
        width: 60px;
        height: 60px;
        background: #f0f6ed;
        border-radius: 17px;
        color: #83a18b;
        font-size: 25px;
    }

    .ht-checkin-empty h3 {
        font-size: 14px;
        font-weight: 800;
        color: #45604a;
        margin-bottom: 8px;
    }

    .ht-checkin-empty p {
        font-size: 11px;
        color: #9aa69d;
    }

    .ht-checkin-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 17px;
        padding: 13px 16px;
        border-radius: 10px;
        font-size: 12px;
    }

    .ht-checkin-alert.success {
        background: #e8f6ec;
        color: #277a4b;
    }

    .ht-checkin-alert.error {
        background: #fff0ed;
        color: #bb5848;
    }

    .ht-checkin-alert.info {
        background: #eef5ff;
        color: #52749d;
    }

    @@media (max-width: 1100px) {
        .ht-checkin-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 850px) {
        .ht-checkin-tools {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .ht-checkin-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .ht-checkin-heading h1 {
            font-size: 21px;
        }

        .ht-checkin-stats {
            grid-template-columns: 1fr;
        }

        .ht-checkin-panel {
            padding: 16px;
        }

        .ht-list-panel {
            padding: 0;
        }

        .ht-checkin-table {
            min-width: 800px;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("htScanForm");
        const input = document.getElementById("htQrInput");
        const error = document.getElementById("htQrError");

        if (!form || !input || !error) {
            return;
        }

        form.addEventListener("submit", function (event) {
            let value = input.value.trim();

            error.hidden = true;
            error.textContent = "";

            if (!value) {
                event.preventDefault();
                error.textContent = "Vui lòng nhập mã QR.";
                error.hidden = false;
                return;
            }

            if (
                value.startsWith("http://") ||
                value.startsWith("https://") ||
                value.startsWith("/")
            ) {
                try {
                    const url = new URL(value, window.location.origin);
                    const token = url.searchParams.get("token");

                    if (
                        url.origin !== window.location.origin ||
                        url.pathname.toLowerCase() !==
                            "/quanlydon/scancheckin" ||
                        !token
                    ) {
                        event.preventDefault();
                        error.textContent =
                            "Liên kết QR không đúng địa chỉ Check-in của website.";
                        error.hidden = false;
                        return;
                    }

                    value = token;
                } catch {
                    event.preventDefault();
                    error.textContent = "Đường dẫn QR không hợp lệ.";
                    error.hidden = false;
                    return;
                }
            }

            input.value = value;
        });
    });
</script>
